{
  "entities": {
    "UserStats": {
      "title": "UserStats",
      "description": "User's overall progress and skill levels",
      "type": "object",
      "properties": {
        "level": { "type": "integer" },
        "xp": { "type": "integer" },
        "xpToNextLevel": { "type": "integer" },
        "streak": { "type": "integer" },
        "skills": {
          "type": "object",
          "properties": {
            "Fitness": { "$ref": "SkillStats" },
            "Fokus": { "$ref": "SkillStats" },
            "Disziplin": { "$ref": "SkillStats" },
            "Wissen": { "$ref": "SkillStats" },
            "Soziales": { "$ref": "SkillStats" }
          }
        },
        "avatar": {
          "type": "object",
          "properties": {
            "equipped": { "type": "object" },
            "inventory": { "type": "array", "items": { "type": "string" } },
            "unlockedSkins": { "type": "array", "items": { "type": "string" } },
            "currentSkin": { "type": "string" }
          }
        }
      },
      "required": ["level", "xp", "xpToNextLevel", "streak", "skills", "avatar"]
    },
    "SkillStats": {
      "title": "SkillStats",
      "description": "Stats for a specific skill",
      "type": "object",
      "properties": {
        "level": { "type": "integer" },
        "xp": { "type": "integer" },
        "xpToNextLevel": { "type": "integer" },
        "lastWorkedAt": { "type": "integer" },
        "lastDecayAt": { "type": "integer" },
        "decayedXpTotal": { "type": "integer" },
        "lastDecayAmount": { "type": "integer" },
        "lastDecayDemotedFrom": { "type": "integer" }
      },
      "required": ["level", "xp", "xpToNextLevel"]
    },
    "Quest": {
      "title": "Quest",
      "description": "A task or habit for the user to complete",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "skill": { "type": "string" },
        "xpReward": { "type": "integer" },
        "completed": { "type": "boolean" },
        "failed": { "type": "boolean" },
        "type": { "type": "string", "enum": ["daily", "habit"] },
        "habitDirection": { "type": "string", "enum": ["positive", "negative", "both"] },
        "createdAt": { "type": "integer" },
        "completedAt": { "type": "integer" },
        "dueDate": { "type": "integer" },
        "hasTime": { "type": "boolean" },
        "reminderTiming": { "type": "string" },
        "recurrence": { "type": "string" },
        "recurrenceDays": { "type": "array", "items": { "type": "integer" } },
        "seriesId": { "type": "string" },
        "spawnedNextQuestId": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "completed": { "type": "boolean" }
            }
          }
        },
        "completions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "integer" },
              "direction": { "type": "string", "enum": ["positive", "negative"] }
            }
          }
        }
      },
      "required": ["id", "title", "skill", "xpReward", "completed", "type", "createdAt"]
    },
    "DiaryEntry": {
      "title": "DiaryEntry",
      "description": "A daily reflection entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "integer" },
        "mood": { "type": "integer" },
        "notes": { "type": "string" },
        "progress": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "date", "mood", "notes", "progress", "tags"]
    },
    "DeepTraining": {
      "title": "DeepTraining",
      "description": "Advanced training module for the Coach Library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "iconName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "title", "category", "iconName", "content", "createdAt"]
    },
    "FoodEntry": {
      "title": "FoodEntry",
      "description": "A food diary entry tracking calories and macros",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "integer" },
        "name": { "type": "string" },
        "calories": { "type": "integer" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "type": { "type": "string", "enum": ["Frühstück", "Mittagessen", "Abendessen", "Snack"] }
      },
      "required": ["id", "date", "name", "calories", "type"]
    },
    "WeeklyCoachSummary": {
      "title": "WeeklyCoachSummary",
      "description": "AI-Coach motivational summary generated from a week's mood and progress",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "weekStart": { "type": "integer" },
        "summary": { "type": "string" },
        "avgMood": { "type": ["number", "null"] },
        "loggedDaysCount": { "type": "integer" },
        "totalXp": { "type": "number" },
        "generatedAt": { "type": "integer" }
      },
      "required": ["id", "weekStart", "summary", "loggedDaysCount", "totalXp", "generatedAt"]
    },
    "HealthRecord": {
      "title": "HealthRecord",
      "description": "Synchronized daily sleep, activity, recovery, cardiovascular, respiratory, and body composition metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "date": { "type": "integer" },
        "sleepDurationMinutes": { "type": "integer" },
        "activityDurationMinutes": { "type": "integer" },
        "avgHeartRate": { "type": ["integer", "null"] },
        "sleepDeepMinutes": { "type": ["integer", "null"] },
        "sleepLightMinutes": { "type": ["integer", "null"] },
        "sleepRemMinutes": { "type": ["integer", "null"] },
        "sleepAwakeMinutes": { "type": ["integer", "null"] },
        "steps": { "type": ["integer", "null"] },
        "distanceMeters": { "type": ["integer", "null"] },
        "caloriesActive": { "type": ["integer", "null"] },
        "floorsClimbed": { "type": ["integer", "null"] },
        "heartPoints": { "type": ["integer", "null"] },
        "workoutsCount": { "type": ["integer", "null"] },
        "restingHeartRate": { "type": ["integer", "null"] },
        "hrvMs": { "type": ["number", "null"] },
        "stressLevel": { "type": ["integer", "null"] },
        "bodyBattery": { "type": ["integer", "null"] },
        "spo2Percent": { "type": ["number", "null"] },
        "respirationRate": { "type": ["number", "null"] },
        "vo2Max": { "type": ["number", "null"] },
        "weightKg": { "type": ["number", "null"] },
        "bodyFatPercent": { "type": ["number", "null"] },
        "hydrationMl": { "type": ["integer", "null"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["browser_idle", "device_motion", "web_bluetooth", "health_export", "aura_activity", "garmin_connect", "google_health", "manual"]
          }
        },
        "recoveryScore": { "type": "integer" },
        "recoveryState": { "type": "string", "enum": ["depleted", "strained", "balanced", "charged"] },
        "acceptedSuggestionIds": { "type": "array", "items": { "type": "string" } },
        "dismissedSuggestionIds": { "type": "array", "items": { "type": "string" } },
        "syncedAt": { "type": "integer" }
      },
      "required": ["id", "date", "sleepDurationMinutes", "activityDurationMinutes", "sources", "recoveryScore", "recoveryState", "syncedAt"]
    },
    "WeeklyRetrospective": {
      "title": "WeeklyRetrospective",
      "description": "Sunday AI-generated weekly retrospective analyzing mood fluctuations, goal achievement, and motivating next-week outlook",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "weekStart": { "type": "integer" },
        "weekEnd": { "type": "integer" },
        "headline": { "type": "string", "maxLength": 300 },
        "moodFluctuationAnalysis": { "type": "string", "maxLength": 4000 },
        "goalAchievementAnalysis": { "type": "string", "maxLength": 4000 },
        "nextWeekOutlook": { "type": "string", "maxLength": 4000 },
        "focusRecommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "skill": { "type": "string" },
              "xpReward": { "type": "integer" }
            }
          }
        },
        "avgMood": { "type": ["number", "null"] },
        "minMood": { "type": ["integer", "null"] },
        "maxMood": { "type": ["integer", "null"] },
        "moodSwingRange": { "type": ["number", "null"] },
        "moodVolatility": { "type": ["number", "null"] },
        "loggedMoodDays": { "type": "integer" },
        "completedQuestsCount": { "type": "integer" },
        "failedQuestsCount": { "type": "integer" },
        "questCompletionRate": { "type": "integer" },
        "habitPositiveCount": { "type": "integer" },
        "habitNegativeCount": { "type": "integer" },
        "totalXp": { "type": "number" },
        "totalFocusMinutes": { "type": "integer" },
        "adoptedRecommendationIds": { "type": "array", "items": { "type": "string" } },
        "generatedAt": { "type": "integer" },
        "triggerType": { "type": "string", "enum": ["sunday_auto", "manual"] }
      },
      "required": [
        "id",
        "weekStart",
        "weekEnd",
        "headline",
        "moodFluctuationAnalysis",
        "goalAchievementAnalysis",
        "nextWeekOutlook",
        "focusRecommendations",
        "loggedMoodDays",
        "completedQuestsCount",
        "failedQuestsCount",
        "questCompletionRate",
        "habitPositiveCount",
        "habitNegativeCount",
        "totalXp",
        "totalFocusMinutes",
        "generatedAt",
        "triggerType"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserStats",
      "description": "User's profile and stats"
    },
    "/users/{userId}/quests/{questId}": {
      "schema": "Quest",
      "description": "User's quests and habits"
    },
    "/users/{userId}/diaryEntries/{diaryEntryId}": {
      "schema": "DiaryEntry",
      "description": "User's diary entries"
    },
    "/users/{userId}/visions/{visionId}": {
      "schema": "Vision",
      "description": "User's vision board entries"
    },
    "/users/{userId}/focusSessions/{sessionId}": {
      "schema": "FocusSession",
      "description": "User's focus training sessions"
    },
    "/users/{userId}/deepTrainings/{trainingId}": {
      "schema": "DeepTraining",
      "description": "Generated daily training modules"
    },
    "/users/{userId}/foodEntries/{entryId}": {
      "schema": "FoodEntry",
      "description": "User's food journal entries"
    },
    "/users/{userId}/weeklyCoachSummaries/{summaryId}": {
      "schema": "WeeklyCoachSummary",
      "description": "Generated AI-Coach motivational weekly mood summaries"
    },
    "/users/{userId}/healthRecords/{recordId}": {
      "schema": "HealthRecord",
      "description": "Synchronized daily sleep and activity recovery records"
    },
    "/users/{userId}/weeklyRetrospectives/{retroId}": {
      "schema": "WeeklyRetrospective",
      "description": "Sunday AI-powered weekly retrospectives analyzing mood swings and goal achievement"
    }
  }
}
